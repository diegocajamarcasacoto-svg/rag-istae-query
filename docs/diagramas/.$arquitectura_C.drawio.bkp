<mxfile host="app.diagrams.net"><diagram id="arqC" name="Arquitectura C"><mxGraphModel dx="1200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1480" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Arquitectura C · RAG jerárquico&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;línea base LB-1 · rag-istae-query&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="330" height="45" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Pregunta del usuario&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="220" height="50" as="geometry"/></mxCell><mxCell id="e5" value='&lt;b&gt;Embedding de la pregunta&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;multilingual-e5-base · prefijo «query:»&lt;br&gt;vector de 768 dimensiones, normalizado&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="300" height="62" as="geometry"/></mxCell><mxCell id="gq" value="&lt;b&gt;Qdrant&lt;/b&gt; · una sola consulta (2 Prefetch + fusión RRF)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#8C9BAE;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontColor=#4A6585;" vertex="1" parent="1"><mxGeometry x="220" y="190" width="740" height="225" as="geometry"/></mxCell><mxCell id="bm25" value='&lt;b&gt;Recuperación léxica BM25&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;índice de texto nativo · 20 candidatos&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="250" y="235" width="300" height="60" as="geometry"/></mxCell><mxCell id="sem" value='&lt;b&gt;Recuperación semántica&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;similitud coseno · 20 candidatos&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="640" y="235" width="300" height="60" as="geometry"/></mxCell><mxCell id="rrf" value='&lt;b&gt;Fusión RRF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;k = 60&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="495" y="335" width="170" height="55" as="geometry"/></mxCell><mxCell id="dbq" value='&lt;b&gt;Colección istae_chunks_e5_base&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;9.623 fragmentos&lt;br&gt;vectores E5 («passage:», ingesta)&lt;br&gt;+ índice de texto&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#F4F4F4;strokeColor=#8C8C8C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="15" y="245" width="185" height="95" as="geometry"/></mxCell><mxCell id="rr" value='&lt;b&gt;Reranking&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;bge-reranker-base · 20 candidatos → 5 mejores fragmentos&lt;br&gt;&lt;i&gt;en LB-1; decisión sí/no pendiente de evaluación&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="360" y="445" width="440" height="66" as="geometry"/></mxCell><mxCell id="units" value='&lt;b&gt;units.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;2.748 unidades&lt;br&gt;fragmento → artículo&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#F4F4F4;strokeColor=#8C8C8C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="50" y="545" width="170" height="80" as="geometry"/></mxCell><mxCell id="exp" value='&lt;b&gt;Expansión a artículos (small-to-big)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;fragmento → artículo completo · deduplicado&lt;br&gt;artículo ≤ 1.500 tokens; si es mayor, fragmentos acertados ±1&lt;br&gt;contexto base ≤ 4.000 tokens&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="330" y="540" width="500" height="90" as="geometry"/></mxCell><mxCell id="gh" value='&lt;b&gt;&lt;font style="font-size:14px"&gt;CAPA DE JERARQUÍA NORMATIVA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(aporte del trabajo)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2D9;strokeColor=#C07A12;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="230" y="665" width="700" height="470" as="geometry"/></mxCell><mxCell id="h1" value='&lt;b&gt;1. Normas superiores relacionadas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;desde las normas del contexto base · relaciones «Desarrolla» y «Debe ser compatible con»&lt;br&gt;solo hacia rango estrictamente superior · hasta 2 saltos · omite normas ya presentes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FFE3A8;strokeColor=#C07A12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="265" y="725" width="630" height="80" as="geometry"/></mxCell><mxCell id="h2" value='&lt;b&gt;2. Búsqueda filtrada en esas normas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;misma pregunta · híbrida BM25 + E5 con RRF · 20 candidatos en conjunto · reranking&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FFE3A8;strokeColor=#C07A12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="300" y="830" width="560" height="62" as="geometry"/></mxCell><mxCell id="h3" value='&lt;b&gt;3. Selección&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;hasta 3 artículos nuevos · 1 por norma · sin score mínimo&lt;br&gt;subidos a artículo (≤ 1.500 tokens c/u) · presupuesto propio ≤ 1.500 tokens&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FFE3A8;strokeColor=#C07A12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="300" y="917" width="560" height="75" as="geometry"/></mxCell><mxCell id="h4" value='&lt;b&gt;4. Presentación por rango&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;documentos ordenados por nivel · escala jerárquica&lt;br&gt;marca «incluida por jerarquía» · relaciones entre las normas presentes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FFE3A8;strokeColor=#C07A12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="290" y="1017" width="580" height="78" as="geometry"/></mxCell><mxCell id="cat" value='&lt;b&gt;Catálogo normativo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;46 normas · rangos 2–6&lt;br&gt;214 relaciones&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#FFF2D9;strokeColor=#C07A12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="725" width="175" height="80" as="geometry"/></mxCell><mxCell id="pr" value='&lt;b&gt;Prompt modular&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;base + RAG + &lt;b&gt;jerarquía&lt;/b&gt; + recordatorio de formato&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="380" y="1170" width="400" height="60" as="geometry"/></mxCell><mxCell id="gen" value='&lt;b&gt;Generación (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Nemotron 3 Ultra vía OpenRouter · temperatura 0,2&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="380" y="1265" width="400" height="60" as="geometry"/></mxCell><mxCell id="ans" value='&lt;b&gt;Respuesta con citas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;[INT08-art12] · sección «Fuentes» · abstención si no hay respaldo&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="1360" width="460" height="62" as="geometry"/></mxCell><mxCell id="note" value='&lt;font style="font-size:10px" color="#555555"&gt;&lt;i&gt;Conversación de un tema: las preguntas de seguimiento reutilizan el contexto recuperado para la primera pregunta, sin recuperar de nuevo.&lt;/i&gt;&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="1432" width="600" height="30" as="geometry"/></mxCell><mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q" target="bm25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="q" target="e5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e5" target="sem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="bm25" target="rrf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="sem" target="rrf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rrf" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rr" target="exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exp" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C07A12;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C07A12;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C07A12;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h4" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pr" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A6585;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gen" target="ans"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9A9A9A;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dbq" target="gq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9A9A9A;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="units" target="exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#C07A12;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cat" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>