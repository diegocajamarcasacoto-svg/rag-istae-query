 y="1060" width="280" height="46" as="geometry"/></mxCell><mxCell id="e31" value="mismos units[] + context · cached: true" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1135" as="sourcePoint"/><mxPoint x="580" y="1135" as="targetPoint"/><mxPoint as="offset" y="-8"/></mxGeometry></mxCell><mxCell id="e32" value="mismo prompt y contexto + historial reciente (≤ 6 mensajes)&lt;br&gt;+ pregunta nueva" style="html=1;endArrow=block;endFill=1;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1190" as="sourcePoint"/><mxPoint x="1120" y="1190" as="targetPoint"/><mxPoint as="offset" y="-15"/></mxGeometry></mxCell><mxCell id="e33" value="texto en streaming" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="1225" as="sourcePoint"/><mxPoint x="580" y="1225" as="targetPoint"/><mxPoint as="offset" y="-8"/></mxGeometry></mxCell><mxCell id="e34" value="SSE delta … SSE answer" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1260" as="sourcePoint"/><mxPoint x="310" y="1260" as="targetPoint"/><mxPoint as="offset" y="-8"/></mxGeometry></mxCell><mxCell id="e35" value="Respuesta; si el contexto no alcanza,&lt;br&gt;sugiere abrir una conversación nueva" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="1310" as="sourcePoint"/><mxPoint x="75" y="1310" as="targetPoint"/><mxPoint as="offset" y="-15"/></mxGeometry></mxCell><mxCell id="v36" value='&lt;font style="font-size:10px" color="#555555"&gt;&lt;i&gt;B y C difieren solo en &lt;b&gt;hierarchy&lt;/b&gt; (false / true) y en el módulo de jerarquía del prompt. Si /retrieve falla (401, 503 o tiempo agotado de 90 s), la API emite &lt;b&gt;SSE error&lt;/b&gt;.&lt;br&gt;La integración de B/C en rag-istae-api es la propuesta de docs/guia_integracion_api.md (la implementa su responsable); A y AJ, de contexto largo, no usan /retrieve.&lt;/i&gt;&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="1340" width="1200" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>